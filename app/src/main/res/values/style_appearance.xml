<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="NormalTextAppearance">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">@dimen/text_subtitle_size</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="fontWeight">400</item>
    </style>

    <style name="TabTextAppearance">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">@dimen/text_tab_size</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="fontWeight">500</item>
    </style>

    <style name="myBottomNavStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/text_bottom_nav_size</item>
        <item name="fontWeight">400</item>
    </style>

    <style name="PlaylistViewTextStyle">
        <item name="android:fontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/playlist_info_text_size</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="LibraryBottomSheetTextStyle">
        <item name="android:fontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_library_sheet_size</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="SheetViewNamePlaylistTextStyle">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">@dimen/text_subtitle_size</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="fontWeight">400</item>
    </style>

    <style name="SheetViewAmountPlaylistTextStyle">
        <item name="android:textColor">?attr/sheetRecyclerItemColor</item>
        <item name="android:textSize">@dimen/text_item_amount_song_size</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="fontWeight">400</item>
    </style>
</resources>